# --- CDP Faucet (Coinbase Developer Platform) ---
# Dapatkan di https://portal.cdp.coinbase.com/api-keys (Secret API Key, format PEM Ed25519)
CDP_API_KEY_ID=your-key-id
CDP_API_KEY_SECRET=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n
# Opsional, hanya dipakai kalau mau fitur wallet dari CDP SDK
# CDP_WALLET_SECRET=your-wallet-secret

# --- Custom HTTP faucet (faucet apa pun yang punya endpoint API terbuka) ---
# CUSTOM_FAUCET_URL=https://faucet.example.com/api/drip
# CUSTOM_FAUCET_METHOD=POST
# CUSTOM_FAUCET_HEADERS={"Authorization":"Bearer TOKEN","Content-Type":"application/json"}
# CUSTOM_FAUCET_BODY={"address":"{{address}}","network":"sepolia"}

# --- Override RPC publik (berguna untuk testing / RPC sendiri) ---
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Cooldown default antar claim per (network, faucet, address), dalam jam ---
# COOLDOWN_HOURS=12
